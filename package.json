{
  "name": "@lofcz/react-image-editor",
  "version": "2.0.0",
  "description": "A fully local React image editor with an editable Canvas2D document, layers and history",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./document": {
      "import": {
        "types": "./dist/document.d.mts",
        "default": "./dist/document.mjs"
      },
      "require": {
        "types": "./dist/document.d.ts",
        "default": "./dist/document.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "ignore"
    }
  },
  "packageManager": "pnpm@11.20.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "tsup --watch",
    "dev": "pnpm --dir demo run dev",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:package": "node test/document-module.mjs",
    "test:browser": "node test/browser.mjs && node test/core-browser.mjs && node test/browser-interactions.mjs && node test/browser-ui.mjs && node test/browser-path-selection.mjs && node test/browser-rich-text.mjs && node test/browser-text-ui.mjs && node test/browser-text-contrast.mjs && node test/browser-crop.mjs && node test/browser-crop-ui.mjs && node test/browser-rights.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm run lint && pnpm run typecheck && pnpm test",
    "release": "pnpm run build && pnpm publish",
    "bootstrap:publish": "node scripts/bootstrap-publish.mjs"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.9",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.4",
    "playwright": "1.65.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.10"
  },
  "author": "lofcz",
  "contributors": [
    "Unlayer (original React wrapper)"
  ],
  "homepage": "https://github.com/lofcz/react-image-editor#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lofcz/react-image-editor.git"
  },
  "keywords": [
    "react",
    "react-component",
    "image",
    "image-editor",
    "photo-editor",
    "image-editing",
    "canvas",
    "offline"
  ]
}
